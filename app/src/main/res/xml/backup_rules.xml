<?xml version="1.0" encoding="utf-8"?><!--
   AUD-11: the app stores auth tokens, private reports with coordinates, photos
   and the pending upload queue in private storage. None of it is safe to copy
   to another device, so everything is excluded.

   Auto Backup is also disabled in AndroidManifest (android:allowBackup="false").
   These rules are the second line of defence: they keep the data out of
   device-to-device transfer and out of any backup if the flag is ever flipped
   back. The auth session itself is additionally encrypted and stored in
   noBackupFilesDir (see EncryptedSessionManager).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
